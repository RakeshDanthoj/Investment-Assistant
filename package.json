{
  "name": "finnwise",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.6.0"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 127.0.0.1 --port 8000 --reload-dir . --reload-dir ..",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm --filter frontend typecheck",
    "test": "pnpm -r run test",
    "test:backend": "python -m pytest -q backend/tests",
    "lint:backend": "python -m ruff check backend",
    "build": "pnpm -r run build",
    "perf:lighthouse": "pnpm --filter frontend perf:lighthouse",
    "perf:lighthouse:desktop": "pnpm --filter frontend perf:lighthouse:desktop",
    "perf:lighthouse:budget-test": "pnpm --filter frontend perf:lighthouse:budget-test"
  }
}
